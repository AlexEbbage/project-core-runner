:root {
    --cr-bg: rgb(7, 12, 24);
    --cr-bg-elevated: rgb(14, 23, 42);
    --cr-surface: rgb(22, 34, 58);
    --cr-surface-strong: rgb(31, 48, 79);
    --cr-line: rgba(130, 162, 205, 0.28);
    --cr-text: rgb(240, 246, 255);
    --cr-text-muted: rgb(158, 177, 204);
    --cr-cyan: rgb(66, 220, 255);
    --cr-blue: rgb(77, 126, 255);
    --cr-orange: rgb(255, 140, 48);
    --cr-red: rgb(255, 80, 86);
    --cr-green: rgb(83, 225, 153);
    --cr-yellow: rgb(255, 207, 92);
    --cr-space-1: 4px;
    --cr-space-2: 8px;
    --cr-space-3: 12px;
    --cr-space-4: 16px;
    --cr-space-5: 24px;
    --cr-space-6: 32px;
    --cr-radius-sm: 8px;
    --cr-radius-md: 14px;
    --cr-radius-lg: 22px;
}
