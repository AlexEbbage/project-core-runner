:root {
    --cr-bg: rgb(4, 10, 22);
    --cr-bg-soft: rgb(7, 15, 29);
    --cr-surface: rgb(11, 23, 41);
    --cr-surface-raised: rgb(16, 31, 52);
    --cr-surface-hover: rgb(21, 40, 66);
    --cr-line: rgba(116, 143, 181, 0.26);
    --cr-line-strong: rgba(134, 166, 210, 0.48);
    --cr-text: rgb(245, 248, 253);
    --cr-text-soft: rgb(188, 199, 218);
    --cr-text-muted: rgb(125, 145, 175);
    --cr-orange: rgb(255, 82, 34);
    --cr-orange-strong: rgb(236, 45, 21);
    --cr-orange-soft: rgba(255, 82, 34, 0.14);
    --cr-blue: rgb(42, 137, 255);
    --cr-cyan: rgb(63, 215, 255);
    --cr-green: rgb(71, 220, 127);
    --cr-yellow: rgb(255, 190, 53);
    --cr-purple: rgb(164, 89, 255);
    --cr-danger: rgb(255, 75, 82);
    --cr-space-1: 8px;
    --cr-space-2: 14px;
    --cr-space-3: 20px;
    --cr-space-4: 28px;
    --cr-space-5: 38px;
    --cr-space-6: 52px;
    --cr-radius-sm: 12px;
    --cr-radius-md: 20px;
    --cr-radius-lg: 30px;
    --cr-radius-xl: 42px;
}
