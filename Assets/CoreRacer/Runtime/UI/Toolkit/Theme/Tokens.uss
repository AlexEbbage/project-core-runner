:root {
    --cr-bg: rgb(2, 8, 20);
    --cr-bg-elevated: rgb(7, 17, 34);
    --cr-surface: rgb(9, 22, 42);
    --cr-surface-strong: rgb(17, 36, 64);
    --cr-line: rgba(126, 157, 200, 0.38);
    --cr-text: rgb(240, 246, 255);
    --cr-text-muted: rgb(158, 177, 204);
    --cr-cyan: rgb(66, 220, 255);
    --cr-blue: rgb(77, 126, 255);
    --cr-orange: rgb(255, 74, 25);
    --cr-red: rgb(255, 80, 86);
    --cr-green: rgb(83, 225, 153);
    --cr-yellow: rgb(255, 207, 92);
    --cr-space-1: 8px;
    --cr-space-2: 16px;
    --cr-space-3: 24px;
    --cr-space-4: 32px;
    --cr-space-5: 48px;
    --cr-space-6: 64px;
    --cr-radius-sm: 14px;
    --cr-radius-md: 22px;
    --cr-radius-lg: 34px;
}
