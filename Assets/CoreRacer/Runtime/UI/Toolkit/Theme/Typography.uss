.game-ui-root {
    color: var(--cr-text);
    font-size: 24px;
}

.screen-title {
    color: var(--cr-text);
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.screen-title--center { align-self: center; }

.screen-subtitle,
.body-copy,
.modal-body {
    color: var(--cr-text-soft);
    font-size: 23px;
    white-space: normal;
}

.screen-subtitle { margin-top: 4px; }
.section-heading {
    color: var(--cr-text);
    font-size: 27px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.section-support {
    color: var(--cr-text-muted);
    font-size: 20px;
    white-space: normal;
}
.metric-label {
    color: var(--cr-text-muted);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
}
.card-title { color: var(--cr-text); font-size: 26px; -unity-font-style: bold; }
.modal-title { color: var(--cr-text); font-size: 36px; -unity-font-style: bold; }
.inline-status { color: var(--cr-yellow); font-size: 20px; white-space: normal; }
.status-text { color: var(--cr-text-muted); font-size: 18px; }
