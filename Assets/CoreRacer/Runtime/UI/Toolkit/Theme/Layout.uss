.game-ui-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: transparent;
}

.safe-area { flex-grow: 1; }
.layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.layer--screen { background-color: var(--cr-bg); }
.layer--hud, .layer--overlay, .layer--popup, .layer--effects, .layer--toast, .layer--loading { background-color: transparent; }

.main-menu-screen { flex-grow: 1; background-color: var(--cr-bg); }
.top-bar {
    height: 154px;
    min-height: 154px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 18px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(116, 143, 181, 0.18);
}
.menu-content { flex-grow: 1; min-height: 0; }
.menu-page {
    flex-grow: 1;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 28px;
    padding-bottom: 36px;
}
.menu-page > .unity-scroll-view__content-container { padding-bottom: 28px; }
.screen-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
}
.screen-heading--center { flex-direction: column; justify-content: center; }
.bottom-nav {
    height: 124px;
    min-height: 124px;
    flex-direction: row;
    align-items: stretch;
    margin-left: 18px;
    margin-right: 18px;
    margin-bottom: 14px;
    padding: 8px;
    background-color: rgba(12, 25, 43, 0.97);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--cr-line);
    border-right-color: var(--cr-line);
    border-bottom-color: var(--cr-line);
    border-left-color: var(--cr-line);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.component-gallery {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 24px;
    bottom: 24px;
    padding: 36px;
    background-color: var(--cr-bg);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--cr-line-strong);
    border-right-color: var(--cr-line-strong);
    border-bottom-color: var(--cr-line-strong);
    border-left-color: var(--cr-line-strong);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
}
