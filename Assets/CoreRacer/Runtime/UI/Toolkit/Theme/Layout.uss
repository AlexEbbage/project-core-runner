.game-ui-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: transparent;
}

.layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.layer--hud { picking-mode: ignore; }
.layer--screen { background-color: var(--cr-bg); }
.layer--overlay,
.layer--popup,
.layer--toast,
.layer--loading { picking-mode: ignore; }

.layer--overlay > *,
.layer--popup > *,
.layer--toast > *,
.layer--loading > * { picking-mode: position; }

.is-hidden { display: none; }

.main-menu-screen {
    flex-grow: 1;
}

.top-bar {
    height: 84px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--cr-space-4);
    padding-right: var(--cr-space-4);
    padding-top: var(--cr-space-3);
    padding-bottom: var(--cr-space-2);
    background-color: var(--cr-bg-elevated);
    border-bottom-width: 1px;
    border-bottom-color: var(--cr-line);
}

.profile-chip {
    min-width: 120px;
    align-items: flex-start;
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.profile-level {
    color: var(--cr-text);
    font-size: 19px;
    -unity-font-style: bold;
}

.resource-strip {
    flex-direction: row;
    align-items: center;
}

.resource-chip {
    min-width: 62px;
    min-height: 34px;
    margin-left: var(--cr-space-2);
    padding-left: var(--cr-space-3);
    padding-right: var(--cr-space-3);
    -unity-text-align: middle-center;
    background-color: var(--cr-surface);
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.resource-chip--coin { color: var(--cr-orange); }
.resource-chip--premium { color: var(--cr-cyan); }

.menu-content {
    flex-grow: 1;
    overflow: hidden;
}

.menu-page {
    flex-grow: 1;
    padding-top: var(--cr-space-5);
    padding-right: var(--cr-space-4);
    padding-bottom: 112px;
    padding-left: var(--cr-space-4);
}

.bottom-nav {
    position: absolute;
    left: var(--cr-space-3);
    right: var(--cr-space-3);
    bottom: var(--cr-space-3);
    height: 76px;
    flex-direction: row;
    align-items: stretch;
    background-color: rgba(14, 23, 42, 0.98);
    border-top-left-radius: var(--cr-radius-lg);
    border-top-right-radius: var(--cr-radius-lg);
    border-bottom-left-radius: var(--cr-radius-lg);
    border-bottom-right-radius: var(--cr-radius-lg);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--cr-line);
    border-right-color: var(--cr-line);
    border-bottom-color: var(--cr-line);
    border-left-color: var(--cr-line);
    padding-top: var(--cr-space-2);
    padding-right: var(--cr-space-2);
    padding-bottom: var(--cr-space-2);
    padding-left: var(--cr-space-2);
}

.nav-button {
    flex-grow: 1;
    min-width: 0;
    padding-left: 2px;
    padding-right: 2px;
    color: var(--cr-text-muted);
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 10px;
}

.nav-button.is-selected {
    color: var(--cr-text);
    background-color: var(--cr-surface-strong);
}

.tab-row,
.action-row {
    flex-direction: row;
    margin-bottom: var(--cr-space-3);
}

.tab-button {
    flex-grow: 1;
    min-width: 0;
    color: var(--cr-text-muted);
    background-color: transparent;
    border-top-color: var(--cr-line);
    border-right-color: var(--cr-line);
    border-bottom-color: var(--cr-line);
    border-left-color: var(--cr-line);
    font-size: 10px;
    padding-left: 4px;
    padding-right: 4px;
}

.tab-button.is-selected {
    color: var(--cr-cyan);
    background-color: var(--cr-surface);
    border-bottom-color: var(--cr-cyan);
}

.action-row__button {
    flex-grow: 1;
    margin-right: var(--cr-space-2);
}

.play-button {
    min-height: 62px;
    margin-top: var(--cr-space-5);
    font-size: 18px;
}

.modal-backdrop {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: var(--cr-space-5);
    background-color: rgba(3, 7, 15, 0.84);
}

.modal-card {
    width: 100%;
    max-width: 520px;
    padding: var(--cr-space-5);
    background-color: var(--cr-bg-elevated);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--cr-cyan);
    border-right-color: var(--cr-line);
    border-bottom-color: var(--cr-line);
    border-left-color: var(--cr-line);
    border-top-left-radius: var(--cr-radius-lg);
    border-top-right-radius: var(--cr-radius-lg);
    border-bottom-left-radius: var(--cr-radius-lg);
    border-bottom-right-radius: var(--cr-radius-lg);
}

.result-grid {
    margin-top: var(--cr-space-4);
    margin-bottom: var(--cr-space-4);
}

.result-stat {
    color: var(--cr-text);
    font-size: 18px;
    -unity-font-style: bold;
    padding-top: var(--cr-space-2);
    padding-bottom: var(--cr-space-2);
    border-bottom-width: 1px;
    border-bottom-color: var(--cr-line);
}

.action-stack { margin-top: var(--cr-space-3); }

.tutorial-overlay {
    position: absolute;
    left: var(--cr-space-4);
    right: var(--cr-space-4);
    bottom: 96px;
    padding: var(--cr-space-4);
    background-color: rgba(14, 23, 42, 0.96);
    border-left-width: 4px;
    border-left-color: var(--cr-orange);
    border-top-left-radius: var(--cr-radius-md);
    border-top-right-radius: var(--cr-radius-md);
    border-bottom-left-radius: var(--cr-radius-md);
    border-bottom-right-radius: var(--cr-radius-md);
}

.tutorial-title { color: var(--cr-orange); -unity-font-style: bold; }
.tutorial-body { color: var(--cr-text); white-space: normal; margin-top: var(--cr-space-2); }
.tutorial-button { margin-top: var(--cr-space-3); }

.hud-safe-area {
    flex-grow: 1;
    padding-top: var(--cr-space-4);
    padding-right: var(--cr-space-4);
    padding-left: var(--cr-space-4);
}

.hud-metrics { align-self: flex-start; }
.hud-stat { color: var(--cr-text); -unity-font-style: bold; font-size: 14px; text-shadow: 1px 1px 2px rgb(0, 0, 0); }
.hud-stat--accent { color: var(--cr-orange); }
.hud-stat--danger { color: var(--cr-red); }
.pause-button { position: absolute; right: var(--cr-space-4); top: var(--cr-space-4); width: 50px; picking-mode: position; }
.powerup-strip { position: absolute; left: var(--cr-space-4); right: var(--cr-space-4); top: 110px; }

.toast {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: 108px;
    padding: var(--cr-space-3);
    color: var(--cr-text);
    background-color: var(--cr-surface-strong);
    -unity-text-align: middle-center;
    border-top-left-radius: var(--cr-radius-md);
    border-top-right-radius: var(--cr-radius-md);
    border-bottom-left-radius: var(--cr-radius-md);
    border-bottom-right-radius: var(--cr-radius-md);
}

.loading-card { margin: auto; align-items: center; }
.loading-title { color: var(--cr-cyan); -unity-font-style: bold; letter-spacing: 2px; }
.loading-bar { width: 220px; height: 6px; margin-top: var(--cr-space-3); background-color: var(--cr-surface); }
.loading-fill { width: 55%; height: 100%; background-color: var(--cr-cyan); }

.component-gallery {
    background-color: var(--cr-bg);
    padding: var(--cr-space-5);
}

@media (min-width: 720px) {
    .menu-page {
        padding-left: 12%;
        padding-right: 12%;
    }
    .card-grid { flex-direction: row; flex-wrap: wrap; }
    .card-grid > .dynamic-card { width: 48%; margin-right: 2%; }
}
