.gameplay-hud { flex-grow: 1; position: relative; }
.hud-top-row { height: 132px; flex-direction: row; align-items: center; padding-left: 28px; padding-right: 28px; padding-top: 18px; }
.hud-metric { width: 235px; }
.hud-metric--center { flex-grow: 1; align-items: center; }
.hud-metric__label { color: rgb(41, 53, 77); font-size: 18px; -unity-font-style: bold; letter-spacing: 2px; }
.hud-metric__value { color: rgb(16, 27, 49); font-size: 42px; -unity-font-style: bold; }
.hud-metric__value--accent { color: rgb(218, 42, 36); }
.hud-currency { width: 160px; flex-direction: row; align-items: center; justify-content: center; }
.hud-currency__icon { width: 48px; height: 48px; color: rgb(255, 160, 15); background-color: rgba(255, 190, 53, 0.16); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; -unity-text-align: middle-center; font-size: 25px; -unity-font-style: bold; }
.hud-currency__value { color: rgb(24, 34, 55); font-size: 31px; -unity-font-style: bold; margin-left: 9px; }
.hud-pause { width: 72px; height: 72px; min-width: 72px; min-height: 72px; background-color: rgba(255, 255, 255, 0.9); border-top-color: rgba(34, 47, 69, 0.12); border-right-color: rgba(34, 47, 69, 0.12); border-bottom-color: rgba(34, 47, 69, 0.12); border-left-color: rgba(34, 47, 69, 0.12); }
.hud-pause .icon-button__glyph { color: rgb(23, 34, 56); }
.hud-progress-row { align-items: center; padding-left: 170px; padding-right: 170px; }
.hud-progress { width: 100%; height: 10px; }
.hud-progress > .unity-progress-bar__background { background-color: rgba(43, 56, 79, 0.2); }
.hud-progress > .unity-progress-bar__progress { background-color: rgb(218, 42, 36); }
.hud-progress > .unity-progress-bar__title { display: none; }
.hud-zone { color: rgb(218, 42, 36); font-size: 22px; -unity-font-style: bold; letter-spacing: 2px; margin-top: 10px; }
.hud-health { position: absolute; left: 28px; top: 136px; color: rgb(218, 42, 36); font-size: 17px; -unity-font-style: bold; }
.powerup-strip { position: absolute; left: 22px; right: 22px; bottom: 190px; flex-direction: row; justify-content: space-between; align-items: flex-end; }
.hud-powerup { min-width: 126px; min-height: 106px; align-items: center; justify-content: center; padding: 10px; background-color: rgba(255, 255, 255, 0.86); border-top-left-radius: 48px; border-top-right-radius: 48px; border-bottom-left-radius: 48px; border-bottom-right-radius: 48px; }
.hud-powerup__icon { color: rgb(218, 42, 36); font-size: 34px; -unity-font-style: bold; }
.hud-powerup__label { color: rgb(48, 58, 78); font-size: 13px; -unity-font-style: bold; }
