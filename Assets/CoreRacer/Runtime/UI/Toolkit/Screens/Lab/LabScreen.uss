.lab-hero { width: 200px; height: 116px; align-items: center; justify-content: center; background-color: rgba(255, 82, 34, 0.08); border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-left-radius: 30px; border-bottom-right-radius: 30px; }
.lab-hero__icon { color: var(--cr-orange); font-size: 68px; }
.lab-section { padding: 22px; margin-bottom: 18px; background-color: rgba(11, 23, 41, 0.56); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: var(--cr-line); border-right-color: var(--cr-line); border-bottom-color: var(--cr-line); border-left-color: var(--cr-line); border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; }
.lab-section__heading { margin-bottom: 16px; }
