.gallery-row { flex-direction: row; margin-top: 12px; margin-bottom: 28px; }
.gallery-row .button { flex-grow: 1; margin-right: 10px; }
.gallery-sample { padding: 26px; margin-top: 12px; margin-bottom: 22px; background-color: var(--cr-surface); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: var(--cr-line); border-right-color: var(--cr-line); border-bottom-color: var(--cr-line); border-left-color: var(--cr-line); border-top-left-radius: 24px; border-top-right-radius: 24px; border-bottom-left-radius: 24px; border-bottom-right-radius: 24px; }
