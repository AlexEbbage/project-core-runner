<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="/Assets/CoreRacer/Runtime/UI/Toolkit/Theme/Tokens.uss" />
    <ui:Style src="/Assets/CoreRacer/Runtime/UI/Toolkit/Theme/Typography.uss" />
    <ui:Style src="/Assets/CoreRacer/Runtime/UI/Toolkit/Theme/Components.uss" />
    <ui:Style src="/Assets/CoreRacer/Runtime/UI/Toolkit/Theme/Utilities.uss" />
    <ui:Style src="/Assets/CoreRacer/Runtime/UI/Toolkit/Theme/Layout.uss" />
    <ui:Template name="MainMenuTemplate" src="/Assets/CoreRacer/Runtime/UI/Toolkit/Shell/MainMenuShell.uxml" />
    <ui:Template name="GameplayHudTemplate" src="/Assets/CoreRacer/Runtime/UI/Toolkit/Hud/GameplayHud.uxml" />
    <ui:Template name="RunOverlaysTemplate" src="/Assets/CoreRacer/Runtime/UI/Toolkit/Overlays/RunOverlays.uxml" />
    <ui:Template name="GalleryTemplate" src="/Assets/CoreRacer/Runtime/UI/Toolkit/Gallery/ComponentGallery.uxml" />

    <ui:VisualElement name="GameUiRoot" class="game-ui-root">
        <ui:VisualElement name="SafeArea" class="safe-area">
            <ui:VisualElement name="HudLayer" class="layer layer--hud is-hidden">
                <ui:Instance template="GameplayHudTemplate" />
            </ui:VisualElement>
            <ui:VisualElement name="ScreenLayer" class="layer layer--screen">
                <ui:Instance template="MainMenuTemplate" />
            </ui:VisualElement>
            <ui:VisualElement name="OverlayLayer" class="layer layer--overlay">
                <ui:Instance template="RunOverlaysTemplate" />
            </ui:VisualElement>
            <ui:VisualElement name="PopupLayer" class="layer layer--popup">
                <ui:VisualElement name="GenericModal" class="modal-backdrop is-hidden">
                    <ui:VisualElement class="modal-panel">
                        <ui:Label name="ModalTitle" text="DETAILS" class="modal-title" />
                        <ui:Label name="ModalBody" text="" class="modal-body" />
                        <ui:VisualElement class="modal-actions">
                            <ui:Button name="ModalCloseButton" text="CLOSE" class="button button--secondary" />
                            <ui:Button name="ModalPrimaryButton" text="CONFIRM" class="button button--primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="EffectsLayer" class="layer layer--effects" />
            <ui:VisualElement name="ToastLayer" class="layer layer--toast">
                <ui:Label name="Toast" text="" class="toast is-hidden" />
            </ui:VisualElement>
            <ui:VisualElement name="LoadingLayer" class="layer layer--loading is-hidden">
                <ui:VisualElement class="loading-panel">
                    <ui:Label text="LOADING" class="loading-title" />
                    <ui:ProgressBar name="LoadingProgress" value="25" class="progress-meter" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Instance template="GalleryTemplate" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
