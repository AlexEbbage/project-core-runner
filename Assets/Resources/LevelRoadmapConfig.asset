    requiredProfileLevel: 4
    shapeSprite: {fileID: 0}
    challengeOne: Reach 8,000 score
    challengeTwo: Travel 1,000m
    challengeThree: Collect 40 coins
  - id: route_nonagon
    displayName: NONAGON
